/PROG  READDATA	  Macro
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Read Op. Data";
PROG_SIZE	= 4084;
CREATE		= DATE 22-03-13  TIME 11:57:18;
MODIFIED	= DATE 22-03-13  TIME 11:57:18;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 160;
MEMORY_SIZE	= 4776;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  JMP LBL[1] ;
   2:  !******************************** ;
   3:  !COMPANY ;
   4:  !PSG Module ;
   5:  !This programs reads the PLC ;
   6:  !Data to Determine the Requested ;
   7:  !Operation for the robot. ;
   8:  ! ;
   9:  !******************************** ;
  10:  LBL[1: BEGIN] ;
  11:   ;
  12:  LBL[3] ;
  13:  !Don't read as long as ;
  14:  !previous op is on ;
  15:  IF DO[18:Gripper 1 Part Present]=OFF AND DO[21:Gripper 1 Vacuum Off]=OFF,JMP LBL[5] ;
  16:  WAIT    .05(sec) ;
  17:  IF DI[15:Gripper 2 Vacuum Off]=ON,CALL RST_DATA ;
  18:  JMP LBL[3] ;
  19:   ;
  20:  LBL[5:RESET Data] ;
  21:  !RESET all the data ;
  22:  CALL RST_DATA    ;
  23:   ;
  24:  !Monitor requests and ;
  25:  ! DI[16:Read Data] ;
  26:  CALL CHK_RDY(16) ;
  27:  IF R[6:GRD Ld & UL Time]=1,JMP LBL[999] ;
  28:   ;
  29:  !If data is ready, don't wait ;
  30:  IF DI[16:Gripper 2 Blow Off]=ON,JMP LBL[7] ;
  31:  WAIT    .20(sec) ;
  32:  IF DI[16:Gripper 2 Blow Off]=OFF,JMP LBL[5] ;
  33:   ;
  34:  !******************************** ;
  35:  LBL[7:Data is Ready] ;
  36:  !******************************** ;
  37:  $WAITTMOUT=300 ;
  38:  IF GI[1]=R[40],JMP LBL[10] ;
  39:  !Validate part style 1 ;
  40:  WAIT GI[1]>0 TIMEOUT,LBL[210] ;
  41:  IF (GI[1]>R[42:Temp Outfeed X]),JMP LBL[210] ;
  42:  !Style change detected ;
  43:  R[40]=GI[1]    ;
  44:  LBL[10] ;
  45:  !Set registers to check data ;
  46:  R[40]=GI[1]    ;
  47:  !R[41:Part Style 2]=GI[2:Part Sty ;
  48:  WAIT (R[50]>0 OR R[55]>0) TIMEOUT,LBL[11] ;
  49:  LBL[11] ;
  50:  R[50]=GI[3:Style Code]    ;
  51:  R[51:Part Style]=GI[4:Outfeed Prt Cont]    ;
  52:  R[55]=GI[5]    ;
  53:  R[56:Grinder Ld PR]=GI[6]    ;
  54:   ;
  55:  IF (!F[2]),JMP LBL[15] ;
  56:  IF R[50]<>0,CALL ALRM_LOG('UnLoad Station =',' ','INFO',50,17) ;
  57:  IF R[51:Part Style]<>0,CALL ALRM_LOG('UnLoad Location =',' ','INFO',51,18) ;
  58:  IF R[55]<>0,CALL ALRM_LOG('Load Station   =',' ','INFO',55,17) ;
  59:  IF R[56:Grinder Ld PR]<>0,CALL ALRM_LOG('Load Location   =',' ','INFO',56,18) ;
  60:  LBL[15] ;
  61:   ;
  62:  !Validate part style 2 ;
  63:  !IF GI[2]<1 OR GI[2]>2,JMP LBL[21 ;
  64:   ;
  65:  !If no data set for operation 1 ;
  66:  !jump to operation 2 data ;
  67:  IF R[50]<1,JMP LBL[25] ;
  68:  !Validate Unload station ;
  69:  IF R[50]<1 OR R[50]>R[52],JMP LBL[220] ;
  70:  !Validate Unload locn ;
  71:  IF R[51:Part Style]<1 OR R[51:Part Style]>R[53],JMP LBL[221] ;
  72:   ;
  73:  !If Op1 info ok, Op2 not required ;
  74:  IF R[55]<1,JMP LBL[40] ;
  75:   ;
  76:  LBL[25:Validate Opr 2] ;
  77:  !Validate Load station ;
  78:  IF R[55]<1 OR R[55]>R[57:Grinder Unld PR],JMP LBL[230] ;
  79:   ;
  80:  !Validate Load location ;
  81:  IF R[56:Grinder Ld PR]<1 OR R[56:Grinder Ld PR]>R[58:Audit Ld PR],JMP LBL[231] ;
  82:   ;
  83:  !******************************** ;
  84:  LBL[40:Set acknowledges] ;
  85:  !******************************** ;
  86:   ;
  87:  !Set Acknowledges ;
  88:  GO[1]=R[40] ;
  89:  !GO[2]=R[41:Part Style 2] ;
  90:  GO[3:Program Status]=R[50] ;
  91:  GO[4]=R[51:Part Style] ;
  92:  GO[5]=R[55] ;
  93:  GO[6]=R[56:Grinder Ld PR] ;
  94:   ;
  95:  DO[16:Gripper 2 Blow On]=ON ;
  96:   ;
  97:  !Wait for Read Data input to turn ;
  98:  !or to RESET data ;
  99:  WAIT DI[16:Gripper 2 Blow Off]=OFF OR DI[15:Gripper 2 Vacuum Off]=ON    ;
 100:  IF DI[15:Gripper 2 Vacuum Off]=ON,JMP LBL[5] ;
 101:  DO[16:Gripper 2 Blow On]=OFF ;
 102:  !Load/Unload data fault = off ;
 103:  GO[7]=0 ;
 104:  !Style Error = OFf ;
 105:  DO[70:Spare]=(OFF) ;
 106:   ;
 107:  !Validate part style 1 ;
 108:  IF R[40]<1 OR R[40]>R[42:Temp Outfeed X],JMP LBL[210] ;
 109:  !style valid - check for change ;
 110:  IF R[43:Temp Outfeed Y]=R[40],JMP LBL[45] ;
 111:  !** Style Change ** ;
 112:  R[43:Temp Outfeed Y]=R[40]    ;
 113:  !load part-specific data ;
 114:  ! if needed ;
 115:  LBL[45] ;
 116:   ;
 117:  LBL[999] ;
 118:  END ;
 119:   ;
 120:  !******************************** ;
 121:  !FAULT HANDLING ;
 122:  !******************************** ;
 123:  LBL[210:Part Style 1 Err] ;
 124:  CALL ALRM_LOG('STYLE ID ERROR: ','Invalid Style 1','WARN') ;
 125:  DO[70:Spare]=(ON) ;
 126:  DO[66:Outfeed New Ack]=(ON) ;
 127:  JMP LBL[40] ;
 128:   ;
 129:  LBL[211:Part Style 2 Err] ;
 130:  CALL ALRM_LOG('STYLE ID ERROR: ','Invalid Style 2','WARN') ;
 131:  DO[70:Spare]=(ON) ;
 132:  DO[66:Outfeed New Ack]=(ON) ;
 133:  JMP LBL[40] ;
 134:   ;
 135:  LBL[220:Bad Station 1] ;
 136:  CALL ALRM_LOG('OpSta1 # is IN','VALID/NOT Setup','WARN',50,9) ;
 137:  DO[66:Outfeed New Ack]=(ON) ;
 138:  GO[7]=1 ;
 139:  JMP LBL[40] ;
 140:   ;
 141:  LBL[221:Bad Location 1] ;
 142:  CALL ALRM_LOG('OPLoc1 # is IN','VALID/NOT Setup','WARN',51,9) ;
 143:  DO[66:Outfeed New Ack]=(ON) ;
 144:  GO[7]=1 ;
 145:  JMP LBL[40] ;
 146:   ;
 147:  LBL[230:Bad Station 2] ;
 148:  CALL ALRM_LOG('OPSta2 # is IN','VALID/NOT Setup','WARN',55,9) ;
 149:  DO[66:Outfeed New Ack]=(ON) ;
 150:  GO[7]=2 ;
 151:  JMP LBL[40] ;
 152:   ;
 153:  LBL[231:Bad Location 2] ;
 154:  CALL ALRM_LOG('OPLoc2 # is IN','VALID/NOT Setup','WARN',56,9) ;
 155:  DO[66:Outfeed New Ack]=(ON) ;
 156:  GO[7]=2 ;
 157:  JMP LBL[40] ;
 158:   ;
 159:  LBL[99:End of Program] ;
 160:   ;
/POS
/END
