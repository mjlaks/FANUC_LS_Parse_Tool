/PROG  ROUTER	  Macro
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Pounce Router";
PROG_SIZE	= 6945;
CREATE		= DATE 22-07-01  TIME 07:23:44;
MODIFIED	= DATE 29-06-14  TIME 05:04:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 366;
MEMORY_SIZE	= 7953;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 1200,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/APPL

LINE_TRACK;
  LINE_TRACK_SCHEDULE_NUMBER      : 0;
  LINE_TRACK_BOUNDARY_NUMBER      : 0;
  CONTINUE_TRACK_AT_PROG_END      : FALSE;

/MN
   1:  !******************************* ;
   2:  !COMPANY ;
   3:  !PROJECT 0000000 ;
   4:  !CUSTOMER ;
   5:  ! ;
   6:  !Date: February 10, 2020 ;
   7:  ! ;
   8:  !Router for paths between ;
   9:  !pounce positions ;
  10:  ! ;
  11:  !******************************* ;
  12:  LBL[1:Begin] ;
  13:   ;
  14:  !Set Move Defaults ;
  15:  R[11:Router Speed]=40    ;
  16:  R[12:Router CNT Value]=70    ;
  17:  R[100:Max Recov Dist]=25    ;
  18:  R[101:Number Perches]=7    ;
  19:  R[102:First Perch PR#]=1    ;
  20:  R[104:Curr Perch PR#]=0    ;
  21:   ;
  22:  UFRAME_NUM=1 ;
  23:  UTOOL_NUM=1 ;
  24:   ;
  25:  !Set destination reg ;
  26:  R[103:Dest Perch PR#]=AR[1]    ;
  27:   ;
  28:  LBL[2:Check] ;
  29:  !Check current position ;
  30:  IF R[104:Curr Perch PR#]=0,JMP LBL[3] ;
  31:   ;
  32:  R[111]=R[102:First Perch PR#]+R[101:Number Perches]-1    ;
  33:   ;
  34:  !Range check curr ;
  35:  IF R[104:Curr Perch PR#]<R[102:First Perch PR#] OR R[104:Curr Perch PR#]>R[111],JMP LBL[5000] ;
  36:   ;
  37:  !Range check dest ;
  38:  IF R[103:Dest Perch PR#]<R[102:First Perch PR#] OR R[103:Dest Perch PR#]>R[111],JMP LBL[5100] ;
  39:   ;
  40:  !Robot must be at current perch ;
  41:  IF SO[7:TP enabled]=ON,JMP LBL[3] ;
  42:  IF R[104:Curr Perch PR#]=0,JMP LBL[3] ;
  43:  JMP LBL[4] ;
  44:   ;
  45:  LBL[3:Find Posn] ;
  46:  CALL RECOVERY    ;
  47:  CALL GET_POS    ;
  48:  IF R[104:Curr Perch PR#]<>0,JMP LBL[4] ;
  49:  DO[58:TP Input Required]=ON ;
  50:  CALL GO_PERCH    ;
  51:  DO[58:TP Input Required]=OFF ;
  52:  JMP LBL[2] ;
  53:   ;
  54:   ;
  55:  !-------------------------------- ;
  56:  LBL[4:Select From PosR] ;
  57:  !-------------------------------- ;
  58:  SELECT R[104:Curr Perch PR#]=1,JMP LBL[100] ;
  59:         =2,JMP LBL[200] ;
  60:         =3,JMP LBL[300] ;
  61:         =4,JMP LBL[400] ;
  62:         =5,JMP LBL[500] ;
  63:         =6,JMP LBL[600] ;
  64:         =7,JMP LBL[700] ;
  65:         ELSE,JMP LBL[5000] ;
  66:   ;
  67:   ;
  68:  !-------------------------------- ;
  69:  LBL[100:From PR1(Home)] ;
  70:  !-------------------------------- ;
  71:  SELECT R[103:Dest Perch PR#]=1,JMP LBL[101] ;
  72:         =2,JMP LBL[102] ;
  73:         =3,JMP LBL[103] ;
  74:         =4,JMP LBL[104] ;
  75:         =5,JMP LBL[105] ;
  76:         =6,JMP LBL[106] ;
  77:         =7,JMP LBL[107] ;
  78:         ELSE,JMP LBL[5000] ;
  79:   ;
  80:  LBL[101:To PR1(Home)] ;
  81:  JMP LBL[4950] ;
  82:   ;
  83:  LBL[102:To PR2(Maint)] ;
  84:J PR[2:Maint Perch] 25% CNT80    ;
  85:  JMP LBL[4950] ;
  86:   ;
  87:  LBL[103:To PR3 Outfd] ;
  88:  JMP LBL[4950] ;
  89:   ;
  90:  LBL[104:To PR4 Grd] ;
  91:J PR[4:Grinder Perch] 15% CNT80    ;
  92:  JMP LBL[4950] ;
  93:   ;
  94:  LBL[105:To PR5 Hanoff] ;
  95:  JMP LBL[4950] ;
  96:   ;
  97:  LBL[106:To PR6 Vis] ;
  98:  JMP LBL[4950] ;
  99:   ;
 100:  LBL[107:To PR7(Audit)] ;
 101:J PR[7:Audit] 10% FINE    ;
 102:  JMP LBL[4950] ;
 103:   ;
 104:  !-------------------------------- ;
 105:  LBL[200:From PR2(Maint)] ;
 106:  !-------------------------------- ;
 107:  SELECT R[103:Dest Perch PR#]=1,JMP LBL[201] ;
