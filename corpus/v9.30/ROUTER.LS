 213:J PR[1:Robot Home] 40% CNT80    ;
 214:J PR[7:Audit] 10% FINE    ;
 215:  JMP LBL[4950] ;
 216:   ;
 217:  !-------------------------------- ;
 218:  LBL[500:From PR5(Handof)] ;
 219:  !-------------------------------- ;
 220:  SELECT R[103:Dest Perch PR#]=1,JMP LBL[501] ;
 221:         =2,JMP LBL[502] ;
 222:         =3,JMP LBL[503] ;
 223:         =4,JMP LBL[504] ;
