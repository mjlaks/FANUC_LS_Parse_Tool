/PROG  RSR0001
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Main Sequence";
PROG_SIZE	= 3796;
CREATE		= DATE 22-03-26  TIME 13:25:56;
MODIFIED	= DATE 30-09-27  TIME 08:06:38;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 174;
MEMORY_SIZE	= 4380;
PROTECT		= READ;
TCD:  STACK_SIZE	= 1200,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;

LINE_TRACK;
  LINE_TRACK_SCHEDULE_NUMBER      : 0;
  LINE_TRACK_BOUNDARY_NUMBER      : 0;
  CONTINUE_TRACK_AT_PROG_END      : TRUE;

/MN
   1:  JMP LBL[1] ;
   2:  !******************************** ;
   3:  !COMPANY ;
   4:  !PROJECT 0000000 ;
   5:  !CUSTOMER Example Cell ;
   6:  ! ;
   7:  !Date: March 24, 2022 ;
   8:  ! ;
   9:  !This is the main sequence ;
  10:  !controller for Robot ;
  11:  ! ;
  12:  !******************************** ;
  13:  !NOTE: the following programs ;
  14:  !are not called from Main ;
  15:  !but contain I/O or Registers ;
  16:  !that control the PROCESS ;
  17:  !SHL_IO     SHLCELL ;
  18:  !SHLRESET  SHLSTART ;
  19:  !SHLINIT ;
  20:  !******************************** ;
  21:   ;
  22:  !******************************* ;
  23:  LBL[1:Begin] ;
  24:  !******************************* ;
  25:  Program Status(1) ;
  26:  !Clear user screen ;
  27:  Clear User Page    ;
  28:   ;
  29:  !Reset IO ;
  30:  CALL RESET_IO    ;
  31:   ;
  32:  !Move to home position ;
  33:  CALL HOME    ;
  34:   ;
  35:  !******************************** ;
  36:  LBL[10:Grip Check] ;
  37:  !******************************** ;
  38:   ;
  39:  !Validate START up ;
  40:  !0 = unknown or error ;
  41:  !1 = grip open and empty ;
  42:  !2 = part in grip ;
  43:   ;
  44:  CALL GRPSTAT1    ;
  45:  CALL GRPSTAT2    ;
  46:   ;
  47:  !If Holding Part ;
  48:  !At Startup. ;
  49:  IF (R[143:Grip1_Status]=2),CALL PART_AT_STARTUP1 ;
  50:  IF R[20:Move home abort]=1,JMP LBL[999] ;
  51:  IF (R[148:Grip2_Status]=2),CALL PART_AT_STARTUP2 ;
  52:  IF R[20:Move home abort]=1,JMP LBL[999] ;
  53:   ;
  54:  !******************************* ;
  55:  LBL[40:Startup  ] ;
  56:  !******************************* ;
  57:   ;
  58:  !Set Robot Speed ;
  59:  $MCR.$GENOVERRIDE=R[21:Production speed] ;
  60:   ;
  61:  !******************************* ;
  62:  LBL[50:Main Loop] ;
  63:  !******************************* ;
  64:   ;
  65:  Program Status(2) ;
  66:   ;
  67:  IF DI[57:Request to Enter Cell]=ON,CALL ENTR_REQ ;
  68:   ;
  69:  IF (DI[25:Move to Home] OR DI[36:Robot End Of Cycle] OR R[20:Move home abort]=1),JMP LBL[999] ;
  70:   ;
  71:  IF DI[21:R1 Part Present G1]=ON OR DI[46:Grd 1 Loaded]=ON,JMP LBL[55] ;
  72:   ;
  73:  IF (DI[52:Ok to Load Grinder] OR DI[53:Ok to Unload Grinder]),JMP LBL[60] ;
  74:   ;
  75:  IF (RI[1:Vacuum ON 1] AND DI[54:Ok to Load Outfeed Drawe]),JMP LBL[70] ;
  76:   ;
  77:  //IF DI[46:Grd 1 Loaded]=OFF AND DI[37:Run Out Mode]=ON AND DI[45:R1 Grippers NoPart]=ON,JMP LBL[120] ;
  78:   ;
  79:  IF (RI[1:Vacuum ON 1] AND DI[33:Audit Part Request]),JMP LBL[140] ;
  80:   ;
  81:  IF (RI[3:Vacuum ON 2] AND DI[52:Ok to Load Grinder] OR DI[53:Ok to Unload Grinder]),JMP LBL[120] ;
  82:   ;
  83:  IF (DI[4:Cycle Stop] AND DI[52:Ok to Load Grinder]=ON),JMP LBL[120] ;
  84:   ;
  85:  WAIT    .10(sec) ;
  86:  JMP LBL[50] ;
  87:   ;
  88:  !******************************* ;
  89:  LBL[110:Service full] ;
  90:  !******************************* ;
  91:   ;
  92:  LBL[55:Handoff] ;
  93:  CALL HANDOFF    ;
  94:   ;
  95:  IF R[20:Move home abort]=1,JMP LBL[999] ;
  96:   ;
  97:  LBL[60:LUL Grinder] ;
  98:  CALL LUL_GRINDER    ;
  99:   ;
 100:  IF R[20:Move home abort]=1,JMP LBL[999] ;
 101:   ;
 102:  CALL GRPSTAT1    ;
 103:  CALL GRPSTAT2    ;
 104:  IF (R[143:Grip1_Status]=1 AND R[148:Grip2_Status]=1),JMP LBL[50] ;
 105:  IF (!RO[1:Vacuum ON 1] AND !RO[3:Vacuum ON 2]),JMP LBL[50] ;
 106:   ;
 107:  WAIT (DI[33:Audit Part Request] OR DI[54:Ok to Load Outfeed Drawe])    ;
 108:   ;
 109:  IF DI[33:Audit Part Request]=ON,JMP LBL[140] ;
 110:   ;
 111:  LBL[70:CALL OUTFEED] ;
 112:  CALL LD_OUTFEED    ;
 113:   ;
 114:  IF R[20:Move home abort]=1,JMP LBL[999] ;
 115:   ;
 116:  IF DI[21:R1 Part Present G1]=ON OR DI[22:R1 Part Present G2]=ON,JMP LBL[75] ;
 117:   ;
 118:  IF DI[36:Robot End Of Cycle]=ON,JMP LBL[999] ;
 119:   ;
 120:  LBL[75] ;
 121:  IF DI[65:Outfeed Drawer New Mag]=ON,JMP LBL[140] ;
 122:   ;
 123:  JMP LBL[50] ;
 124:  !******************************* ;
 125:  LBL[120:Service Grinder] ;
 126:  !******************************* ;
 127:   ;
 128:  CALL LUL_GRINDER    ;
 129:  IF R[20:Move home abort]=1,JMP LBL[999] ;
 130:   ;
 131:  IF (!RO[1:Vacuum ON 1] AND !RO[3:Vacuum ON 2]),JMP LBL[50] ;
 132:   ;
 133:  IF DI[65:Outfeed Drawer New Mag]=ON,JMP LBL[140] ;
 134:   ;
 135:  CALL LD_OUTFEED    ;
 136:   ;
 137:  IF R[20:Move home abort]=1,JMP LBL[999] ;
 138:   ;
 139:  IF DI[21:R1 Part Present G1]=ON OR DI[22:R1 Part Present G2]=ON,JMP LBL[125] ;
 140:   ;
 141:  IF DI[36:Robot End Of Cycle]=ON,JMP LBL[999] ;
 142:   ;
 143:  LBL[125] ;
 144:  JMP LBL[50] ;
 145:   ;
 146:  !******************************* ;
 147:  LBL[140:Audit] ;
 148:  !******************************* ;
 149:   ;
 150:  IF DI[33:Audit Part Request]=ON,CALL LD_AUDIT ;
 151:   ;
 152:   ;
 153:  IF R[20:Move home abort]=1,JMP LBL[999] ;
 154:   ;
 155:  IF DI[21:R1 Part Present G1]=ON OR DI[22:R1 Part Present G2]=ON,JMP LBL[145] ;
 156:   ;
 157:  IF DI[36:Robot End Of Cycle]=ON,JMP LBL[999] ;
 158:   ;
 159:  LBL[145] ;
 160:  JMP LBL[50] ;
 161:   ;
 162:  !******************************* ;
 163:  LBL[999:End] ;
 164:  !******************************* ;
 165:  !Robot at home ;
 166:  CALL ROUTER(1) ;
 167:J PR[1:Robot Home] 20% CNT10    ;
 168:  R[104:Curr Perch PR#]=1    ;
 169:  !Turn on clear signals ;
 170:  GO[2:Application Fault]=0 ;
 171:  R[20:Move home abort]=0    ;
 172:  CALL ALL_CLR    ;
 173:   ;
 174:  END ;
/POS
/END
